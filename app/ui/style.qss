/*
 * Project-On — Church Presentation
 * Premium Design System — Obsidian & Gold
 * Refonte 2026 — Modern, Cinematic, Reverent
 */

/* ═══════════════════════════════════════════════════════════════
   BASE STYLES
   ═══════════════════════════════════════════════════════════════ */

QWidget {
    font-family: "Poppins", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #f0f4f8;
    outline: none;
}

QMainWindow {
    background: #050a12;
}

QDialog {
    background: #0a1320;
    border: 1px solid rgba(148, 163, 184, 0.10);
    border-radius: 16px;
}

/* ═══════════════════════════════════════════════════════════════
   TYPOGRAPHY
   ═══════════════════════════════════════════════════════════════ */

QLabel#PanelTitle {
    font-size: 11px;
    font-weight: 700;
    color: #e8b056;
    padding: 12px 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

QLabel#TopBarTitle {
    font-size: 15px;
    font-weight: 600;
    color: #f0f4f8;
}

QLabel#DescLabel {
    color: #7a8fa8;
    font-size: 12px;
    border: none;
    background: transparent;
}

QLabel#Badge {
    background: rgba(232, 176, 86, 0.10);
    color: #e8b056;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
}

/* ═══════════════════════════════════════════════════════════════
   PANELS & CONTAINERS
   ═══════════════════════════════════════════════════════════════ */

QFrame#Panel {
    background: #0a1320;
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 16px;
}

QFrame#Card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0e1928, stop:1 #0c1522);
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 16px;
}

QFrame#Toolbar {
    background: #0f1d2e;
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 10px;
}

QFrame#TopBar {
    background: #0f1d2e;
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 10px;
    min-height: 52px;
}

QFrame#BottomBar {
    background: #0a1320;
    border: none;
    border-top: 1px solid rgba(148, 163, 184, 0.06);
}

QFrame#Divider {
    background: rgba(148, 163, 184, 0.08);
    max-height: 1px;
    min-height: 1px;
}

/* ═══════════════════════════════════════════════════════════════
   INPUT WIDGETS
   ═══════════════════════════════════════════════════════════════ */

QLineEdit, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #0d1825;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 10px;
    padding: 8px 14px;
    color: #f0f4f8;
    selection-background-color: rgba(232, 176, 86, 0.20);
    selection-color: #f5d48a;
}

QLineEdit:hover, QSpinBox:hover {
    background-color: #132033;
    border-color: rgba(203, 213, 225, 0.24);
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #e8b056;
    background-color: #152538;
}

QComboBox {
    background-color: #0d1825;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 10px;
    padding: 6px 14px;
    color: #f0f4f8;
    min-width: 100px;
}

QComboBox:hover {
    background-color: #132033;
    border-color: rgba(203, 213, 225, 0.24);
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: #152538;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 10px;
    selection-background-color: rgba(232, 176, 86, 0.20);
    selection-color: #f5d48a;
    color: #b8c5d6;
    outline: none;
    padding: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   BUTTONS
   ═══════════════════════════════════════════════════════════════ */

QPushButton {
    background: #1c2f45;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 8px;
    padding: 8px 16px;
    color: #f0f4f8;
    font-weight: 600;
}

QPushButton:hover {
    background: #233a55;
    border-color: rgba(203, 213, 225, 0.24);
    color: #ffffff;
}

QPushButton:pressed {
    background: #162a40;
}

QPushButton:disabled {
    color: #4a5d73;
    background: transparent;
    border-color: rgba(148, 163, 184, 0.06);
}

/* Primary Action Buttons */
QPushButton#ProjectButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d4a03c, stop:1 #f0c870);
    color: #050a12;
    border: 1px solid #c48a2e;
    font-weight: 700;
}

QPushButton#ProjectButton:hover {
    background: #f5d48a;
}

QPushButton#AccentButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d4a03c, stop:1 #f0c870);
    color: #050a12;
    border: 1px solid #c48a2e;
    font-weight: 700;
}

QPushButton#AccentButton:hover {
    background: #f5d48a;
}

QPushButton#IconButton {
    padding: 8px;
    background: transparent;
    border: 1px solid transparent;
}

QPushButton#IconButton:hover {
    background: rgba(203, 213, 225, 0.07);
    border-color: rgba(148, 163, 184, 0.10);
}

/* ═══════════════════════════════════════════════════════════════
   LISTS & TREES
   ═══════════════════════════════════════════════════════════════ */

QListView, QTreeView, QListWidget {
    background-color: #0a1320;
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 10px;
    padding: 6px;
}

QListView::item, QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 1px 2px;
    color: #b8c5d6;
}

QListView::item:hover, QListWidget::item:hover {
    background: rgba(203, 213, 225, 0.07);
    color: #f0f4f8;
}

QListView::item:selected, QListWidget::item:selected {
    background: rgba(232, 176, 86, 0.10);
    color: #f5d48a;
    font-weight: 600;
    border: 1px solid rgba(232, 176, 86, 0.22);
}

/* ═══════════════════════════════════════════════════════════════
   TABS
   ═══════════════════════════════════════════════════════════════ */

QTabWidget::pane {
    border: none;
    background: transparent;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    padding: 10px 22px;
    color: #7a8fa8;
    font-weight: 600;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #f0f4f8;
    background: rgba(203, 213, 225, 0.035);
}

QTabBar::tab:selected {
    color: #e8b056;
    border-bottom: 2px solid #e8b056;
}

/* ═══════════════════════════════════════════════════════════════
   CHECKBOXES & RADIO BUTTONS
   ═══════════════════════════════════════════════════════════════ */

QCheckBox {
    color: #b8c5d6;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1px solid rgba(203, 213, 225, 0.24);
    background: #0d1825;
}

QCheckBox::indicator:hover {
    border-color: #e8b056;
    background: rgba(232, 176, 86, 0.08);
}

QCheckBox::indicator:checked {
    background: #e8b056;
    border-color: #e8b056;
    image: url(:/icons/check.svg);
}

QCheckBox::indicator:disabled {
    border-color: rgba(148, 163, 184, 0.06);
    background: transparent;
}

QRadioButton {
    color: #b8c5d6;
    spacing: 8px;
    font-size: 13px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid rgba(203, 213, 225, 0.24);
    background: #0d1825;
}

QRadioButton::indicator:hover {
    border-color: #e8b056;
}

QRadioButton::indicator:checked {
    background: #e8b056;
    border: 3px solid #050a12;
    outline: 1px solid #e8b056;
}

/* ═══════════════════════════════════════════════════════════════
   PROGRESS BAR
   ═══════════════════════════════════════════════════════════════ */

QProgressBar {
    background: #0f1d2e;
    border: 1px solid rgba(148, 163, 184, 0.06);
    border-radius: 6px;
    text-align: center;
    color: #f0f4f8;
    font-size: 10px;
    font-weight: 700;
    height: 6px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d4a03c, stop:1 #f0c870);
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   SLIDER
   ═══════════════════════════════════════════════════════════════ */

QSlider::groove:horizontal {
    height: 4px;
    background: #162a40;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #e8b056;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #e8b056;
    border-radius: 7px;
    border: 2px solid #050a12;
}

QSlider::handle:horizontal:hover {
    background: #f5d48a;
    border-color: #0a1320;
}

QSlider::groove:vertical {
    width: 4px;
    background: #162a40;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #e8b056;
    border-radius: 2px;
}

QSlider::handle:vertical {
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    background: #e8b056;
    border-radius: 7px;
    border: 2px solid #050a12;
}

/* ═══════════════════════════════════════════════════════════════
   GROUP BOX
   ═══════════════════════════════════════════════════════════════ */

QGroupBox {
    color: #7a8fa8;
    border: 1px solid rgba(148, 163, 184, 0.06);
    border-radius: 12px;
    margin-top: 16px;
    padding-top: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -1px;
    padding: 0 6px;
    background: #050a12;
    color: #7a8fa8;
}

/* ═══════════════════════════════════════════════════════════════
   TABLE VIEW & HEADER
   ═══════════════════════════════════════════════════════════════ */

QTableView, QTableWidget {
    background: #0a1320;
    border: 1px solid rgba(148, 163, 184, 0.08);
    border-radius: 10px;
    gridline-color: rgba(148, 163, 184, 0.04);
    selection-background-color: rgba(232, 176, 86, 0.10);
    selection-color: #f5d48a;
    color: #b8c5d6;
}

QTableView::item, QTableWidget::item {
    padding: 6px 12px;
    border: none;
}

QTableView::item:selected, QTableWidget::item:selected {
    background: rgba(232, 176, 86, 0.10);
    color: #f5d48a;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: #0f1d2e;
    color: #7a8fa8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.06);
}

QHeaderView::section:hover {
    background: #152538;
    color: #b8c5d6;
}

/* ═══════════════════════════════════════════════════════════════
   TOOLTIP
   ═══════════════════════════════════════════════════════════════ */

QToolTip {
    background: #1a2d42;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 8px;
    padding: 6px 12px;
    color: #f0f4f8;
    font-size: 12px;
    font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════
   MESSAGE BOX
   ═══════════════════════════════════════════════════════════════ */

QMessageBox {
    background: #0a1320;
}

QMessageBox QLabel {
    color: #b8c5d6;
    font-size: 13px;
    min-width: 280px;
}

/* ═══════════════════════════════════════════════════════════════
   SCROLLBARS — Minimal & Modern
   ═══════════════════════════════════════════════════════════════ */

QScrollBar:vertical {
    background: rgba(203, 213, 225, 0.035);
    width: 8px;
    margin: 4px 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.14);
    border-radius: 4px;
    min-height: 48px;
}

QScrollBar::handle:vertical:hover {
    background: #e8b056;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: rgba(203, 213, 225, 0.035);
    height: 8px;
    margin: 3px 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(148, 163, 184, 0.14);
    border-radius: 4px;
    min-width: 64px;
}

QScrollBar::handle:horizontal:hover {
    background: #e8b056;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}
